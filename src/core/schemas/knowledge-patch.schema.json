{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-project-manager.local/schemas/knowledge-patch.schema.json",
  "title": "AI Project Manager knowledge patch envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "candidate_digest", "targets"],
  "properties": {
    "schema_version": { "const": 1 },
    "change_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "candidate_digest": { "$ref": "#/definitions/digest" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/target" }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digestOrAbsent": {
      "oneOf": [{ "$ref": "#/definitions/digest" }, { "const": "absent" }]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_id",
        "path",
        "operation",
        "before_digest",
        "after_digest",
        "before_image",
        "after_image"
      ],
      "properties": {
        "knowledge_id": { "type": "string", "pattern": "^KNOW-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
        "path": { "type": "string", "pattern": "^knowledge-base/(facts|rules|decisions)/.+\\.md$" },
        "operation": { "enum": ["create", "replace", "delete"] },
        "before_digest": { "$ref": "#/definitions/digestOrAbsent" },
        "after_digest": { "$ref": "#/definitions/digestOrAbsent" },
        "before_image": { "type": ["string", "null"] },
        "after_image": { "type": ["string", "null"] }
      }
    }
  }
}
