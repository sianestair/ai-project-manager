{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-project-manager.local/schemas/change.schema.json",
  "title": "AI Project Manager active Change state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "title",
    "phase",
    "status",
    "base",
    "materials",
    "gates",
    "readiness",
    "implementation",
    "knowledge_promotion",
    "blockers",
    "review",
    "next_action",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "change_id": {
      "$ref": "#/definitions/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "requirements",
        "design",
        "implementation",
        "acceptance",
        "knowledge",
        "archive_ready",
        "archived"
      ]
    },
    "status": {
      "enum": ["active", "blocked", "completed"]
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_revision", "captured_at", "dependencies"],
      "properties": {
        "project_revision": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "captured_at": {
          "$ref": "#/definitions/timestamp"
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["knowledge", "engineering"],
          "properties": {
            "knowledge": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/dependency"
              }
            },
            "engineering": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/dependency"
              }
            }
          }
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "design", "delivery", "knowledge"],
      "properties": {
        "requirements": {
          "$ref": "#/definitions/materialGroup"
        },
        "design": {
          "$ref": "#/definitions/materialGroup"
        },
        "delivery": {
          "$ref": "#/definitions/materialGroup"
        },
        "knowledge": {
          "$ref": "#/definitions/materialGroup"
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "design", "acceptance", "knowledge"],
      "properties": {
        "requirements": {
          "$ref": "#/definitions/gate"
        },
        "design": {
          "$ref": "#/definitions/gate"
        },
        "acceptance": {
          "$ref": "#/definitions/gate"
        },
        "knowledge": {
          "$ref": "#/definitions/gate"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assessed_artifacts", "concerns", "assessed_at"],
      "properties": {
        "status": {
          "enum": ["not_assessed", "pass", "concerns", "fail", "stale"]
        },
        "assessed_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/artifactDigest"
          }
        },
        "concerns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/concern"
          }
        },
        "assessed_at": {
          "oneOf": [
            {
              "$ref": "#/definitions/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "baseline_revision", "final_revision", "checkpoint"],
      "properties": {
        "status": {
          "enum": ["not_started", "in_progress", "verified"]
        },
        "baseline_revision": {
          "$ref": "#/definitions/nullableString"
        },
        "final_revision": {
          "$ref": "#/definitions/nullableString"
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope_digest", "captured_at"],
          "properties": {
            "scope_digest": {
              "$ref": "#/definitions/nullableDigest"
            },
            "captured_at": {
              "oneOf": [
                {
                  "$ref": "#/definitions/timestamp"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "knowledge_promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidate_digest", "patch_digest", "targets", "applied_files"],
      "properties": {
        "status": {
          "enum": ["not_started", "ready", "applied", "verified"]
        },
        "candidate_digest": {
          "$ref": "#/definitions/nullableDigest"
        },
        "patch_digest": {
          "$ref": "#/definitions/nullableDigest"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/knowledgeTarget"
          }
        },
        "applied_files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/artifactDigest"
          }
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archived_at", "final_revision", "applied_files", "confirmation_revisions"],
      "properties": {
        "archived_at": { "$ref": "#/definitions/timestamp" },
        "final_revision": { "type": "string", "minLength": 1 },
        "applied_files": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifactDigest" }
        },
        "confirmation_revisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requirements", "design", "acceptance", "knowledge"],
          "properties": {
            "requirements": { "type": "integer", "minimum": 1 },
            "design": { "type": "integer", "minimum": 1 },
            "acceptance": { "type": "integer", "minimum": 1 },
            "knowledge": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/blocker"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "max_iterations", "last_outcome"],
      "properties": {
        "iteration": {
          "type": "integer",
          "minimum": 0
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "last_outcome": {
          "oneOf": [
            {
              "enum": ["passed", "changes_requested"]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "next_action": {
      "$ref": "#/definitions/action"
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/historyEvent"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        {
          "$ref": "#/definitions/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableString": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "purpose"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/definitions/digest"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "materialGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "included"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "included": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifactDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "artifacts", "confirmed_by", "confirmed_at", "summary", "evidence"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/artifactDigest"
          }
        },
        "confirmed_by": {
          "enum": ["user", "ai_project_manager"]
        },
        "confirmed_at": {
          "$ref": "#/definitions/timestamp"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "material_set", "confirmations"],
      "properties": {
        "status": {
          "enum": ["pending", "confirmed", "invalidated"]
        },
        "material_set": {
          "enum": ["requirements", "design", "delivery", "knowledge"]
        },
        "confirmations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/confirmation"
          }
        }
      }
    },
    "concern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "impact", "owner", "resolution", "touches_user_confirmation"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "$ref": "#/definitions/nullableString"
        },
        "touches_user_confirmation": {
          "type": "boolean"
        }
      }
    },
    "knowledgeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "before_digest", "after_digest"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "before_digest": {
          "oneOf": [
            {
              "$ref": "#/definitions/digest"
            },
            {
              "const": "absent"
            }
          ]
        },
        "after_digest": {
          "oneOf": [
            {
              "$ref": "#/definitions/digest"
            },
            {
              "const": "absent"
            }
          ]
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "blocked_by", "resume_when", "affected_stage", "created_at", "status"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "blocked_by": {
          "enum": ["user", "ai_project_manager", "external", "external_system"]
        },
        "resume_when": {
          "type": "string",
          "minLength": 1
        },
        "affected_stage": {
          "enum": ["requirements", "design", "implementation", "acceptance", "knowledge"]
        },
        "created_at": {
          "$ref": "#/definitions/timestamp"
        },
        "status": {
          "enum": ["open", "resolved"]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "action", "inputs"],
      "properties": {
        "owner": {
          "enum": ["ai_project_manager", "user", "external"]
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "historyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "event", "summary"],
      "properties": {
        "at": {
          "$ref": "#/definitions/timestamp"
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
